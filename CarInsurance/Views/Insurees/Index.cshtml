@model IEnumerable<Insuree>
@{ViewData["Title"]="Insurees";}<h1>Insurees</h1><p><a class="button" asp-action="Create">Create New Quote</a></p><table><thead><tr><th>Name</th><th>Email</th><th>Vehicle</th><th>Quote</th><th></th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.FirstName @item.LastName</td><td>@item.EmailAddress</td><td>@item.CarYear @item.CarMake @item.CarModel</td><td>@item.Quote.ToString("C")</td><td><a asp-action="Edit" asp-route-id="@item.Id">Edit</a> | <a asp-action="Details" asp-route-id="@item.Id">Details</a> | <a asp-action="Delete" asp-route-id="@item.Id">Delete</a></td></tr>}</tbody></table>
