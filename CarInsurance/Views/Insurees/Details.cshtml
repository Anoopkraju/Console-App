@model Insuree
@{ViewData["Title"]="Details";}<h1>Details</h1><dl><dt>Name</dt><dd>@Model.FirstName @Model.LastName</dd><dt>Email</dt><dd>@Model.EmailAddress</dd><dt>Date of Birth</dt><dd>@Model.DateOfBirth.ToShortDateString()</dd><dt>Vehicle</dt><dd>@Model.CarYear @Model.CarMake @Model.CarModel</dd><dt>DUI</dt><dd>@Model.DUI</dd><dt>Speeding Tickets</dt><dd>@Model.SpeedingTickets</dd><dt>Full Coverage</dt><dd>@Model.CoverageType</dd><dt>Monthly Quote</dt><dd>@Model.Quote.ToString("C")</dd></dl><a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> | <a asp-action="Index">Back</a>
