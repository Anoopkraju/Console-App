<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build this project as a console application. -->
  <PropertyGroup>
    <!-- Generate an executable rather than a class library. -->
    <OutputType>Exe</OutputType>
    <!-- Target the .NET 8 runtime. -->
    <TargetFramework>net8.0</TargetFramework>
    <!-- Enable compiler warnings for nullable reference types. -->
    <Nullable>enable</Nullable>
    <!-- Make standard .NET namespaces available automatically. -->
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
